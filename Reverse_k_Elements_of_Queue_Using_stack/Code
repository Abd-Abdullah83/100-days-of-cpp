void reverse_k_element(queue<char>& q,int k)
{
    if (q.size() < k || k<=0)
        return;
    int l = q.size();
    stack<char>s;
    for (int i = 0; i < k; i++)
    {
        s.push(q.front());
        q.pop();
    }
    while (!s.empty())
    {
        q.push(s.top());
        s.pop();
    }
    for (int i = 0; i < l - k; i++)
    {
        q.push(q.front());
        q.pop();
    }
}
